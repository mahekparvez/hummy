{
  "manifest_version": 3,
  "name": "Hummy Capture",
  "version": "0.1.0",
  "description": "Use F9 to record the current browser tab into Hummy.",
  "permissions": ["commands", "offscreen", "tabCapture", "tabs"],
  "host_permissions": ["https://mahekparvez.github.io/*", "http://localhost:4173/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "F9", "mac": "F9" },
      "description": "Start or stop the Hummy tab recording"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mahekparvez.github.io/hummy/*", "http://localhost:4173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
